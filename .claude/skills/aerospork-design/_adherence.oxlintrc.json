{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/controls/**",
              "components/feedback/**",
              "components/icons/**",
              "components/layout/**",
              "ui_kits/cli/**",
              "ui_kits/menu_bar/**",
              "ui_kits/settings_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|help|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, help."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|muted)$/]",
        "message": "<Badge> tone must be one of 'default' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|children|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: kind, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:error|warning)$/]",
        "message": "<Banner> kind must be one of 'error' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|edge|padded|style|key|ref|className|style|children)$/]",
        "message": "<BarStrip> doesn't accept that prop. Declared props: children, edge, padded, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarStrip'] > JSXAttribute[name.name='edge'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<BarStrip> edge must be one of 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|destructive|iconOnly|title|style|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, destructive, iconOnly, title, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:bordered|prominent|borderless)$/]",
        "message": "<Button> variant must be one of 'bordered' | 'prominent' | 'borderless'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:regular|small)$/]",
        "message": "<Button> size must be one of 'regular' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeEditor'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|readOnly|style|key|ref|className|style|children)$/]",
        "message": "<CodeEditor> doesn't accept that prop. Declared props: value, onChange, readOnly, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentUnavailable'] > JSXAttribute > JSXIdentifier[name!=/^(?:sf|title|message|actionTitle|onAction|key|ref|className|style|children)$/]",
        "message": "<ContentUnavailable> doesn't accept that prop. Declared props: sf, title, message, actionTitle, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='CopyButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|help|key|ref|className|style|children)$/]",
        "message": "<CopyButton> doesn't accept that prop. Declared props: value, help."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|title|width|render|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, title, width, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:header|footer|children|style|key|ref|className|style|children)$/]",
        "message": "<FormSection> doesn't accept that prop. Declared props: header, footer, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GapsPreview'] > JSXAttribute > JSXIdentifier[name!=/^(?:innerHorizontal|innerVertical|outerTop|outerBottom|outerLeft|outerRight|width|height|nominalWidth|key|ref|className|style|children)$/]",
        "message": "<GapsPreview> doesn't accept that prop. Declared props: innerHorizontal, innerVertical, outerTop, outerBottom, outerLeft, outerRight, width, height, nominalWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:sf|name|size|weight|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: sf, name, size, weight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='weight'] > Literal[value!=/^(?:regular|light)$/]",
        "message": "<Icon> weight must be one of 'regular' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyRecorderField'] > JSXAttribute > JSXIdentifier[name!=/^(?:notation|recording|onArm|onClear|showsClear|width|key|ref|className|style|children)$/]",
        "message": "<KeyRecorderField> doesn't accept that prop. Declared props: notation, recording, onArm, onClear, showsClear, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='LabeledContent'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|align|key|ref|className|style|children)$/]",
        "message": "<LabeledContent> doesn't accept that prop. Declared props: label, children, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='LabeledContent'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|flex-start)$/]",
        "message": "<LabeledContent> align must be one of 'center' | 'flex-start'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListActionBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:addHelp|removeHelp|onAdd|onRemove|hint|key|ref|className|style|children)$/]",
        "message": "<ListActionBar> doesn't accept that prop. Declared props: addHelp, removeHelp, onAdd, onRemove, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuPanelItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|divider|checked|mono|suffix|shortcut|disabled|help|onClick|key|ref|className|style|children)$/]",
        "message": "<MenuPanelItem> doesn't accept that prop. Declared props: label, divider, checked, mono, suffix, shortcut, disabled, help, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberField'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|value|unit|min|max|onChange|key|ref|className|style|children)$/]",
        "message": "<NumberField> doesn't accept that prop. Declared props: title, value, unit, min, max, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|sf|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: title, sf, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedPicker> doesn't accept that prop. Declared props: options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|width|mono|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: options, value, onChange, width, mono, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SettingsFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<SettingsFooter> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SettingsHint'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<SettingsHint> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|sf|children|style|key|ref|className|style|children)$/]",
        "message": "<StatusLabel> doesn't accept that prop. Declared props: kind, sf, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusLabel'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:ok|error|warning|neutral)$/]",
        "message": "<StatusLabel> kind must be one of 'ok' | 'error' | 'warning' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBarTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|sf|key|ref|className|style|children)$/]",
        "message": "<TabBarTab> doesn't accept that prop. Declared props: id, label, sf."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|mono|variant|align|width|disabled|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: value, onChange, placeholder, mono, variant, align, width, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:rounded|plain)$/]",
        "message": "<TextField> variant must be one of 'rounded' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<TextField> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|disabled|help|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: label, checked, onChange, disabled, help."
      },
      {
        "selector": "JSXOpeningElement[name.name='WindowChrome'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|width|height|children|style|key|ref|className|style|children)$/]",
        "message": "<WindowChrome> doesn't accept that prop. Declared props: title, width, height, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkspaceChipItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|active|type|key|ref|className|style|children)$/]",
        "message": "<WorkspaceChipItem> doesn't accept that prop. Declared props: name, active, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkspaceChipItem'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:workspace|mode)$/]",
        "message": "<WorkspaceChipItem> type must be one of 'workspace' | 'mode'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
